# ============================================================
# الدواء | Al Dawa v2 — نموذج متغيرات البيئة
# انسخ هذا الملف إلى .env واملأ القيم — لا تضع أي سر في الكود أو Git
# توليد أسرار قوية: node scripts/gen-env.mjs
# ============================================================

# --- قاعدة البيانات (PostgreSQL 16) — إلزامي ---
DATABASE_URL="postgresql://aldawa:CHANGE_ME@localhost:5432/aldawa?schema=public"

# --- Redis 7 — إلزامي في الإنتاج (OTP، rate-limit، الطوابير، pub/sub) ---
REDIS_URL="redis://localhost:6379"

# --- سر توقيع الجلسات JWT — إلزامي 32+ حرفًا (فشل الإقلاع بدونه) ---
JWT_SECRET=""

# --- مفتاح تشفير الملفات المعلّقة AES-256-GCM — 32+ حرفًا ---
# يُشتق من JWT_SECRET إذا تُرك فارغًا (للتطوير فقط) — في الإنتاج اضبطه مستقلًا
LAB_ENC_KEY=""

# --- البيئة ---
NODE_ENV="development"
DEMO_MODE="true"            # true فقط للتطوير: يظهر رموز OTP/MFA على الشاشة
TRUSTED_PROXY="false"       # true فقط خلف Caddy/Nginx/Railway موثوق
# --- تسجيل الدخول والتحقق ---
# التحقق من البريد عند إنشاء الحساب (OTP): مُعطَّل افتراضيًا. اجعله "true" بعد ضبط مزود بريد.
EMAIL_VERIFICATION_REQUIRED="false"
# رمز MFA بالبريد لحسابات الأدمن/المعمل/الضابط الطبي/الدكتور.
# غير مضبوط: يتفعل تلقائيًا فقط لو SMTP_HOST مضبوط (وإلا لا يمكن أن يصل الرمز). true/false يفرضان الحالة.
# MFA_EMAIL_REQUIRED="true"
# إعادة ضبط كلمة مرور الأدمن مرة واحدة (مع ADMIN_EMAIL/ADMIN_PASSWORD) ثم احذف المتغير:
# ADMIN_FORCE_RESET="true"
# TRUSTED_IP_HEADER="x-real-ip"  # على Railway: هيدر IP يضبطه الـ proxy (بدل أول عنصر في X-Forwarded-For)
PORT="3000"
PUBLIC_BASE_URL="http://localhost:3000"
ALLOWED_FRAME_ANCESTORS=""  # افتراضي 'self'

# --- كوكي الجلسة (اختياري: true = SameSite None + Secure خلف HTTPS مع iframe) ---
# COOKIE_SECURE="false"
# COOKIE_SAMESITE="lax"      # lax|none|strict — الافتراضي lax إلا لو ALLOWED_FRAME_ANCESTORS مضبوط (iframe خارجي)

# --- التخزين: db (افتراضي الإنتاج) أو local أو s3 (على Railway استخدم s3 — لا يوجد volume مشترك بين app و worker) ---
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR="uploads"
# S3_ENDPOINT="http://localhost:9000"
# S3_BUCKET="aldawa-files"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_REGION="us-east-1"
# S3_FORCE_PATH_STYLE="true" # الافتراضي path-style (R2/MinIO) — false فقط لمزودات virtual-host مثل Railway Bucket

# --- البريد (nodemailer) — بدون قيم: يُسجل في اللوج فقط (وضع وهمي) ---
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS="ضع هنا كلمة مرور SMTP بنفسك — لا توضع في أي ملف يُرفع"
# EMAIL_FROM="Al Dawa <no-reply@aldawa.health>"

# --- المزود الخارجي للذكاء الاصطناعي (OpenAI-compatible) — اختياري ---
# بلا مفتاح: يعمل المزود المدمج المحلي فقط (شرح نصي حتمي)
# EXTERNAL_AI_ENABLED="true"
# EXTERNAL_AI_API_KEY="ضع المفتاح بنفسك في .env — لا تُطبع ولا تُرفع"
# EXTERNAL_AI_BASE_URL="https://api.example.com/v1"
# EXTERNAL_AI_MODEL=""
# EXTERNAL_AI_VISION_MODEL=""

# --- حساب الأدمن الأول (سكربت init-production فقط، لا يُستخدم في الكود) ---
# ADMIN_EMAIL="admin@your-domain.com"
# ADMIN_PASSWORD="ضع كلمة مرور 12+ حرفًا بنفسك في .env"

# --- عامل الخلفية ---
WORKER_CONCURRENCY="2"
